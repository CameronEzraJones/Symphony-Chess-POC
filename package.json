{
  "name": "chess",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:compile": "tsc -p tsconfig.test.json && cp app/globals.css .test-build/globals.css",
    "test:unit": "npm run test:compile && node --test tests/unit/*.test.cjs",
    "test:integration": "npm run test:compile && node --test tests/integration/*.test.cjs",
    "test:e2e": "playwright test",
    "test:coverage": "npm run test:compile && c8 --all --include=\".test-build/**/*.js\" --exclude-after-remap=false --reporter=text --reporter=json-summary node --test tests/unit/*.test.cjs tests/integration/*.test.cjs",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "^10.1.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "npm@11.19.0"
}
